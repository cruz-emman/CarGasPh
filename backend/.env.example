# Application
PROJECT_NAME="CarGasPh Backend"
ENVIRONMENT="development" # development | staging | production
API_V1_STR="/api/v1"
SECRET_KEY="cargasph-super-secret-development-jwt-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_DB="cargasph_dev"
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/cargasph_dev"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Google Maps Platform (Server-side key)
GOOGLE_MAPS_SERVER_KEY="AIzaSyYourServerRestrictedGoogleKey"
