# Base URL to the CarGasPh Backend API (Use machine IP for physical device testing, e.g. http://192.168.1.10:8000/api/v1)
EXPO_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Google Maps Platform Client Keys (Platform restricted in Google Cloud Console)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID="AIzaSyYourAndroidRestrictedKey"
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS="AIzaSyYourIOSRestrictedKey"
